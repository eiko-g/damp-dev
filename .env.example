# Database Configuration
MARIADB_DATABASE=dbname
MARIADB_USER=dbuser
MARIADB_PASSWORD=your_secure_password_here
MARIADB_ROOT_PASSWORD=your_secure_root_password_here

# PHPMyAdmin Configuration
PMA_HOST=db
PMA_USER=root
PMA_PASSWORD=your_secure_root_password_here

# Ports Configuration (for development only)
APACHE_PORT=8080
APACHE_PORT_SSL=8443
MARIADB_PORT=33060
PHPMYADMIN_PORT=8086
XDEBUG_PORT=9003

# PHP Configuration
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=60
PHP_UPLOAD_MAX_FILESIZE=20M
PHP_POST_MAX_SIZE=20M
PHP_TIMEZONE=Asia/Shanghai